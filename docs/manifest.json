{
  "version": 1,
  "documents": [
    {
      "path": "README.md",
      "summary": "Python 검사기의 설치, 소스·테스트 설정, CRAP·mutation 실행과 결과"
    },
    {
      "path": "docs/contributing.md",
      "summary": "문서 색인·소스 연결표 관리, diff 검사와 push 훅 사용"
    }
  ],
  "rules": [
    {
      "id": "checker",
      "sources": [
        "src/**",
        "sentinel-tool/**",
        "pyproject.toml"
      ],
      "documents": [
        "README.md"
      ]
    },
    {
      "id": "toolchain",
      "sources": [
        "scripts/toolchain.py",
        "toolchain.lock.json",
        "backend.lock.json",
        "uv.lock"
      ],
      "documents": [
        "README.md"
      ]
    },
    {
      "id": "documentation-checks",
      "sources": [
        "scripts/docs_lint.py",
        "scripts/verify_repository.sh",
        ".githooks/**",
        ".github/workflows/**",
        "docs/manifest.json",
        "tests/test_docs_lint.py"
      ],
      "documents": [
        "docs/contributing.md"
      ]
    }
  ],
  "ignoreDocuments": []
}
