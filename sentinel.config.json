{
  "specVersion": "1.0.0",
  "modules": [
    {
      "id": "sentinel-py",
      "language": "python",
      "root": ".",
      "production": [
        "scripts/**/*.py",
        "src/sentinel_py/**/*.py"
      ],
      "testCommand": [
        "python",
        "-m",
        "pytest"
      ],
      "coverage": {
        "command": [
          "python",
          "-m",
          "coverage",
          "json"
        ],
        "format": "coverage-py-json",
        "report": "coverage.json"
      },
      "testRoots": [
        "tests"
      ],
      "testPatterns": [
        "*.py"
      ]
    }
  ]
}
